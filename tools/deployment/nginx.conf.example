# Include these locations in the site's existing server {} block.
# Set root to the generated release directory, never the entire project.
# Enable HTTPS in the hosting/server configuration separately.
# Paths below assume the portfolio is served at the domain root.
autoindex off;
set $wizje_cache_control "no-cache, no-transform";
add_header Cache-Control $wizje_cache_control always;
gzip on;
gzip_types text/css text/javascript application/javascript application/json image/svg+xml;
gzip_vary on;
add_header X-Content-Type-Options nosniff always;
add_header Referrer-Policy strict-origin-when-cross-origin always;
add_header X-Frame-Options DENY always;
location = / { try_files /index.html =404; }
location ~ ^/(index\.html|styles\.css|script\.js|collections\.js|globe\.js|favicon\.svg|favicon\.ico|robots\.txt|sitemap\.xml|gallery\.html)$ { try_files $uri =404; }
location = /assets/logo/logo.css { try_files $uri =404; }
location = /assets/logo/social.jpg { try_files $uri =404; }
location ~ ^/assets/fonts/[a-zA-Z0-9_-]+\.(woff2?|ttf|otf|txt)$ { try_files $uri =404; }
location ~ ^/assets/collections/previews/[a-f0-9]+-(?:480|960|1440|2000|inspect)\.jpg$ {
    set $wizje_cache_control "public, max-age=31536000, immutable, no-transform";
    try_files $uri =404;
}
location ~ ^/assets/collections/(manifest|posters)\.js$ { try_files $uri =404; }
location ^~ /.well-known/acme-challenge/ { try_files $uri =404; }
location / { return 404; }
# Remove conflicting proxy_pass / broad asset / regex locations from this server block.
