# Apache 2.4: only the public portfolio may be served from this project.
# Requires AllowOverride for these directives and mod_rewrite.
Options -Indexes -ExecCGI
DirectoryIndex index.html
RewriteEngine On
RewriteRule ^(?:index\.html|styles\.css|script\.js|collections\.js)?$ - [END]
RewriteRule ^assets/logo/logo\.css$ - [END]
RewriteRule ^assets/fonts/[a-zA-Z0-9_-]+\.(?:woff2?|ttf|otf|txt)$ - [END]
RewriteRule ^assets/collections/(?:manifest\.js|previews/[a-f0-9]+-480\.jpg)$ - [END]
RewriteRule ^\.well-known/acme-challenge/[a-zA-Z0-9_-]+$ - [END]
RewriteRule ^ - [F,END]
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
</IfModule>
